#!/bin/sh
# Opt in with: git config core.hooksPath .githooks
# The subject line must be a Conventional Commit. Merge and Revert subjects pass through.

subject=$(grep -v '^#' "$1" | sed '/^$/d' | head -n 1)

if [ -z "$subject" ]; then
  exit 0
fi

case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^(${types})(\\([a-z0-9._/-]+\\))?!?: [a-z0-9]"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: use Conventional Commits, for example: feat(user): add email resend" >&2
  echo "allowed types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi

case "$subject" in
  *.)
    echo "commit-msg: do not end the subject with a period" >&2
    exit 1
    ;;
esac

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; keep it at or under 72" >&2
  exit 1
fi
