# Host .env only. Rails secrets live in credentials.yml.enc; this file unlocks
# them and bootstraps the official Postgres image. Do not put AWS keys here.
# Expected credentials shape: see README Deployment.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app_db

RAILS_MASTER_KEY=CHANGE_ME

RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1

# Used by nginx/certbot and the backup cron (not Rails).
API_HOSTNAME=api.financialcontrol.app.br
CERTBOT_EMAIL=CHANGE_ME
BACKUP_BUCKET=financial-control-ruby-api-dumps
AWS_REGION=us-east-1
